rules_version = '2';

// =====================================================================
// ATIK TOPLAMA PLATFORMU — Firestore Güvenlik Kuralları
// =====================================================================
// Amaç: Uygulama takıma açık bir adreste yayınlanacak. Test modunun
// "herkes her şeyi yapabilir" hâli bu senaryoda kabul edilemez; linki
// alan biri tüm koleksiyonu silebilir.
//
// Bu kurallar uygulamanın İHTİYAÇ DUYDUĞU her şeye izin verir, fazlasına
// vermez:
//   • Okuma          → SADECE giriş yapmış kullanıcılar
//   • Talep oluşturma → giriş şartlı + alan/tip/limit doğrulamalı
//   • Güncelleme      → SADECE sevkiyat alanları (durum, toplayıcı, konum)
//   • SİLME           → TAMAMEN KAPALI (kimse veriyi yok edemez)
//
// ---------------------------------------------------------------------
// GİZLİLİK MASKELEMESİ (KVKK) — neden iki dokümanlı model?
// ---------------------------------------------------------------------
// Firestore kuralları ALAN bazında filtreleme yapamaz; bir dokümanı ya
// tamamen okutur ya hiç okutmaz. Bu yüzden açık adres (tam koordinat) ve
// kullanıcı notu ana dokümanda DURAMAZ — orada dursaydı, arayüzde
// gizlesek bile herkes ham dokümanı okuyabilirdi (uygulamayı hiç açmadan,
// düz bir HTTP isteğiyle).
//
// Çözüm: hassas alanlar `waste_requests/{id}/private/detail` alt
// dokümanında durur ve YALNIZCA şu ikisi okuyabilir:
//   • talebin sahibi (ownerId)
//   • talebi üzerine almış toplayıcı (üst dokümandaki collectorId)
// Yani maske, "Talebi Al" transaction'ı başarılı olduğu anda SUNUCUDA
// kalkar; istemcinin insafına bırakılmaz.
//
// NOT: Firebase Console üzerinden yapılan düzenlemeler yönetici yetkisiyle
// çalışır ve bu kuralları BYPASS eder. Yani demo öncesi koleksiyonu
// Console'dan temizlemeye devam edebilirsin — kuralların engeli olmaz.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // OPERATÖR (yönetici) mi?
    //
    // Yetki, `admins/{uid}` dokümanının VARLIĞINDAN gelir. O koleksiyona
    // uygulamadan yazılamaz; operatör yetkisi yalnızca Firebase Console'dan
    // verilir. Yani kimse kendini operatör ilan edemez.
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // DOĞRULANMIŞ TOPLAYICI mı?
    //
    // Rol seçimi uygulamada yalnızca bir ARAYÜZ tercihidir; güvenlik ona
    // bırakılamaz. Saha görevlisi yetkisi `collectors/{uid}` dokümanının
    // VARLIĞINDAN gelir ve o koleksiyona uygulamadan yazılamaz — yani
    // e-postayla kayıt olan biri kendini toplayıcı ilan edemez.
    function isCollector() {
      return request.auth != null
             && exists(/databases/$(database)/documents/collectors/$(request.auth.uid));
    }

    // --- OPERATÖR LİSTESİ ---
    // Kullanıcı yalnızca KENDİ admin kaydını okuyabilir (uygulama "ben
    // operatör müyüm?" diye sorabilsin diye). Başkasınınkini göremez,
    // yani operatörlerin kim olduğu dışarıya sızmaz.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // --- DOĞRULANMIŞ TOPLAYICI LİSTESİ ---
    // admins ile birebir aynı desen: uygulama yalnızca "ben toplayıcı
    // mıyım?" diye kendi kaydını sorabilir; liste dışarıya sızmaz ve
    // yetki yalnızca Firebase Console'dan (yönetici) verilir.
    match /collectors/{collectorId} {
      allow read: if request.auth != null && request.auth.uid == collectorId;
      allow write: if false;
    }

    match /waste_requests/{requestId} {

      // --- OKUMA ---
      // İşletme kendi talebini, toplayıcı bekleyen talepleri, etki panosu
      // tamamlanmış teslimatları dinliyor. Hepsi okuma gerektirir.
      // ARTIK GİRİŞ ŞARTLI: linki bilen anonim biri koleksiyonu okuyamaz.
      // (Bu dokümanda hassas veri yok; adres/not alt dokümanda.)
      allow read: if request.auth != null;

      // --- TALEP OLUŞTURMA ---
      // Zorunlu alanlar var mı, tipler doğru mu, miktar makul mü?
      // (Bozuk veri girip arayüzü çökertmeyi engeller.)
      //
      // KRİTİK: 'note' ve 'location' anahtarları ana dokümanda YASAK.
      // Böylece ileride biri kodda yanlışlıkla açık adresi buraya yazmaya
      // kalkarsa yazma sunucuda reddedilir — gizlilik, koda değil kurala
      // dayanır.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.keys().hasAll(
                        ['userId', 'wasteTypes', 'estimatedKg', 'approxLocation', 'status']
                      )
                    && !request.resource.data.keys().hasAny(['note', 'location'])
                    && request.resource.data.status == 'bekliyor'
                    && request.resource.data.approxLocation is latlng
                    && request.resource.data.wasteTypes is list
                    && request.resource.data.wasteTypes.size() > 0
                    && request.resource.data.estimatedKg is number
                    && request.resource.data.estimatedKg > 0
                    && request.resource.data.estimatedKg <= 1000;

      // --- GÜNCELLEME ---
      // Yalnızca sevkiyat akışının değiştirdiği alanlara dokunulabilir:
      // userId, approxLocation, wasteTypes, estimatedKg, createdAt
      // DEĞİŞTİRİLEMEZ.
      //
      // KRİTİK — YETKİ, ROLE BAĞLIDIR:
      // Bu kural eskiden yalnızca "hangi alanlar" sorusunu soruyordu,
      // "kim" sorusunu sormuyordu. O hâliyle giriş yapmış herhangi biri
      // başkasının talebine kendini `collectorId` yazıp açık adresini
      // okuyabiliyor, ya da talebi 'tamamlandi' işaretleyip sınırsız
      // Yeşil Puan üretebiliyordu. Artık her meşru geçişin kendi dalı ve
      // kendi kimlik şartı var. (rules_test/rules.test.js bunu ölçer.)
      //
      // Eksik alanlara .get(key, varsayılan) ile erişiliyor: kural
      // değerlendirmesi sırasında olmayan bir alana dokunmak hataya ve
      // dolayısıyla topyekûn redde yol açardı.
      allow update: if request.auth != null && (

        // (A) DOĞRULANMIŞ toplayıcı BEKLEYEN bir talebi üstleniyor.
        //     Kendi UID'sinden başkasını yazamaz -> başkasının adına iş
        //     üstlenip adres okuyamaz.
        //
        //     isCollector() BURADA aranır, (B)'de aranmaz. İki sebeple:
        //       1. Doğruluk: yolculuk ortasında yetkisi kaldırılan
        //          toplayıcının teslimatı askıda kalmamalı — atamanın
        //          kendisi zaten yetkidir.
        //       2. Maliyet: konum yayını ~900 ms'de bir çalışıyor; her
        //          yazmaya exists() eklemek her yayına fazladan bir
        //          doküman okuması bindirirdi.
        (
          isCollector()
          && resource.data.get('status', '') == 'bekliyor'
          && request.resource.data.status == 'atandi'
          && request.resource.data.collectorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'collectorId', 'collectorName',
                         'acceptedAt', 'collectorLocation'])
        )

        // (B) ATANMIŞ toplayıcı: canlı konum yayını ve teslim onayı.
        //     Yalnızca işi üstlenen kişi; ve yalnızca devam eden bir işte
        //     (tamamlanmış talep yeniden tamamlanamaz -> puan tekrar
        //     üretilemez).
        || (
          resource.data.get('collectorId', '') == request.auth.uid
          && resource.data.get('status', '') in ['atandi', 'yolda']
          && request.resource.data.status in ['yolda', 'tamamlandi']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'collectorLocation',
                         'collectorBearing', 'confirmedKg'])
        )

        // (C) Talebin SAHİBİ iptal ediyor — yalnızca henüz beklerken.
        //     "Araç yola çıktıktan sonra iptal edilemez" iş kuralı bugüne
        //     kadar sadece arayüzdeydi; artık sunucuda.
        || (
          resource.data.get('userId', '') == request.auth.uid
          && resource.data.get('status', '') == 'bekliyor'
          && request.resource.data.status == 'iptal'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status'])
        )
      );

      // --- SİLME ---
      // Uygulama hiçbir yerde silme yapmıyor; bu yüzden tamamen kapalı.
      // Linki alan biri koleksiyonu boşaltamaz.
      allow delete: if false;

      // =================================================================
      // HASSAS DETAY: tam koordinat + kullanıcı notu
      // =================================================================
      // Bu alt doküman, gizlilik maskesinin ASIL uygulandığı yerdir.
      match /private/{detailId} {

        // --- OKUMA ---
        // İki kişi okuyabilir:
        //   1. Talebin sahibi          → ownerId alanından (ucuz, get yok)
        //   2. Atanmış toplayıcı       → üst dokümandaki collectorId'den
        // Toplayıcı "Talebi Al" transaction'ını kazanana kadar collectorId
        // boştur; yani maske tam da o anda, sunucuda kalkar.
        allow read: if request.auth != null
                    && (
                         request.auth.uid == resource.data.ownerId
                         || request.auth.uid == get(
                              /databases/$(database)/documents/waste_requests/$(requestId)
                            ).data.collectorId
                       );

        // --- OLUŞTURMA ---
        // Yalnızca kendi adına: ownerId kendi UID'in olmak zorunda.
        // (Üst doküman aynı batch'te oluştuğu için burada get() ile ona
        //  bakamayız — bu yüzden doğrulama ownerId üzerinden yapılır.)
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.ownerId
                      && request.resource.data.exactLocation is latlng;

        // Adres ve not sonradan DEĞİŞTİRİLEMEZ ve SİLİNEMEZ:
        // toplayıcı yola çıktıktan sonra adresin altının oyulması,
        // teslimat kaydının geçmişe dönük çarpıtılması engellenir.
        allow update, delete: if false;
      }
    }

    // =====================================================================
    // ÖDÜL MARKETİ
    // =====================================================================

    // --- ÖDÜL KATALOĞU ---
    // Uygulama katalogu SADECE OKUR. Yazma tamamen kapalı: aksi halde
    // herkes kendine "0 puanlık" ödül tanımlayabilirdi. Katalog Firebase
    // Console'dan (yönetici yetkisiyle) yönetilir.
    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- ÖDÜL TALEPLERİ ---
    // Kullanıcı yalnızca KENDİ taleplerini görür ve yalnızca KENDİ adına
    // talep oluşturabilir.
    //
    // NEDEN OTOMATİK ONAY YOK: Firestore kuralları "bu kullanıcının
    // bakiyesi yetiyor mu?" sorusunu cevaplayamaz — bu, tüm teslimatların
    // toplanmasını gerektirir ve kurallar toplam hesabı yapamaz. Bu yüzden
    // talep 'beklemede' olarak düşer, ATOS operatörü Console'dan onaylar.
    // Bakiyesini aşan bir talep oluşturan biri hiçbir şey kazanmaz;
    // eline geçen tek şey reddedilecek bir kayıttır.
    // (Faz 2: Cloud Functions ile sunucu tarafı otomatik onay.)
    match /redemptions/{redemptionId} {
      // Kendi talebini herkes görür; TÜM talepleri yalnızca operatör görür.
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.userId || isAdmin());

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.status == 'beklemede'
                    && request.resource.data.costPoints is number
                    && request.resource.data.costPoints > 0
                    && request.resource.data.rewardId is string;

      // --- ONAY / RED ---
      // Yalnızca operatör ve YALNIZCA şu üç alan: kullanıcıyı, ödülü veya
      // puanı değiştiremez — muhasebe bütünlüğü korunur.
      // Ayrıca sadece 'beklemede' bir kayıt karara bağlanabilir: verilmiş
      // bir karar sonradan çevrilemez, kararı veren de izini silemez.
      allow update: if isAdmin()
                    && resource.data.status == 'beklemede'
                    && request.resource.data.status in ['onaylandi', 'reddedildi']
                    && request.resource.data.decidedBy == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status', 'decidedAt', 'decidedBy']);

      // Kayıt silme tamamen kapalı: ödül geçmişi yok edilemez.
      allow delete: if false;
    }

    // =================================================================
    // GÜVENİLİRLİK PUANLARI — ratings/{requestId}
    // =================================================================
    // Doküman ID'si TALEP ID'sidir. Bu, mükerrer puanı kural yazarak
    // değil ANAHTAR SEÇEREK engeller: bir teslimata ikinci kayıt açmak
    // yapısal olarak mümkün değildir.
    //
    // Puan sahteciliğine karşı dört şart birlikte aranır:
    //   1. Puanı veren, talebin GERÇEK SAHİBİ olmalı
    //   2. Teslimat GERÇEKTEN tamamlanmış olmalı
    //   3. Puan, o teslimatı yapan TOPLAYICIYA yazılmalı (başkasına değil)
    //   4. Yıldız 1-5 aralığında bir tam sayı olmalı
    // Böylece kimse kendine puan yazamaz, olmayan bir teslimat üzerinden
    // puan üretemez, rakibine kötü puan bırakamaz.
    match /ratings/{requestId} {

      // Karne (ortalama) istemcide hesaplandığı için okuma açık olmalı.
      // Burada hassas veri yoktur: puan, yıldız ve kısa yorumdan ibaret.
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.raterId == request.auth.uid
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && (
                         !('comment' in request.resource.data.keys())
                         || request.resource.data.comment.size() <= 300
                       )
                    // --- Puanlanan teslimat gerçekten bizim mi? ---
                    && get(/databases/$(database)/documents/waste_requests/$(requestId))
                         .data.userId == request.auth.uid
                    && get(/databases/$(database)/documents/waste_requests/$(requestId))
                         .data.status == 'tamamlandi'
                    // --- Puan, işi YAPAN toplayıcıya yazılmalı ---
                    && request.resource.data.collectorId ==
                       get(/databases/$(database)/documents/waste_requests/$(requestId))
                         .data.collectorId;

      // Verilen puan DEĞİŞTİRİLEMEZ ve SİLİNEMEZ: karne geçmişe dönük
      // düzeltilemez, kötü puan sonradan yok edilemez.
      allow update, delete: if false;
    }

    // =================================================================
    // TOPLAMA PLANLARI — schedules/{scheduleId}
    // =================================================================
    // Tamamen KİŞİSEL veri: bir işletmenin hangi gün ne kadar atık
    // verdiği, o işletmenin ticari ritmidir. Bu yüzden ödül/puan
    // koleksiyonlarından farklı olarak okuma bile SAHİBİNE kapalıdır —
    // başka hiçbir hesap (toplayıcı dahil) göremez.
    match /schedules/{scheduleId} {

      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.dayOfMonth is int
                    && request.resource.data.dayOfMonth >= 1
                    // 28 üst sınırı: 29/30/31 "olmayan gün" sorununu
                    // çalışma anında değil tasarımda çözüyoruz.
                    && request.resource.data.dayOfMonth <= 28
                    && request.resource.data.wasteTypes is list
                    && request.resource.data.wasteTypes.size() > 0
                    && request.resource.data.estimatedKg is number
                    && request.resource.data.estimatedKg > 0
                    && request.resource.data.estimatedKg <= 1000
                    && request.resource.data.isActive is bool;

      // Sahibi planı düzenleyebilir; userId ve createdAt DEĞİŞTİRİLEMEZ
      // (plan başkasının üstüne geçirilemez).
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['label', 'dayOfMonth', 'wasteTypes',
                                   'estimatedKg', 'isActive']);

      // Silme yok: pasife alma (isActive:false) kullanılır.
      allow delete: if false;
    }

    // --- DİĞER TÜM KOLEKSİYONLAR ---
    // Varsayılan: kapalı. İleride yeni koleksiyon eklenirse kuralı
    // bilinçli olarak yazılmak zorunda kalınır (güvenli varsayılan).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
